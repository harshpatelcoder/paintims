<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PaintStock SaaS - Authentication</title>
  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #F8FAFC;
      color: #0F172A;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 1rem;
    }
    .auth-card {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      width: 100%;
      max-width: 440px;
      padding: 2.5rem 2rem;
    }
    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: #0284C7;
      font-weight: 700;
      font-size: 1.4rem;
      text-decoration: none;
      margin-bottom: 0.5rem;
    }
    .btn-sky {
      background-color: #0EA5E9;
      color: #FFFFFF;
      font-weight: 600;
      border: none;
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      transition: background-color 0.2s ease, transform 0.1s ease;
    }
    .btn-sky:hover {
      background-color: #0284C7;
      color: #FFFFFF;
    }
    .form-control {
      border-color: #E2E8F0;
      padding: 0.7rem 0.9rem;
      border-radius: 8px;
    }
    .form-control:focus {
      border-color: #0EA5E9;
      box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
    }
    .text-sky {
      color: #0284C7;
    }
    .rule-box {
      background-color: #E0F2FE;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
      color: #0369A1;
    }
  </style>
</head>
<body>

<div class="auth-card">
  <div class="text-center mb-4">
    <a href="/login" class="brand-logo">
      <i data-lucide="paint-bucket" class="lucide"></i>
      <span>PaintStock</span>
    </a>
    <div class="text-muted small">Multi-Shop Inventory Management SaaS</div>
  </div>

  <% if (typeof error_msg !== 'undefined' && error_msg) { %>
    <div class="alert alert-danger border-0 rounded-3 small py-2 px-3 mb-3 d-flex align-items-center gap-2">
      <i data-lucide="alert-circle" style="width: 18px; height: 18px;"></i>
      <div><%= error_msg %></div>
    </div>
  <% } %>

  <% if (typeof success_msg !== 'undefined' && success_msg) { %>
    <div class="alert alert-success border-0 rounded-3 small py-2 px-3 mb-3 d-flex align-items-center gap-2">
      <i data-lucide="check-circle" style="width: 18px; height: 18px;"></i>
      <div><%= success_msg %></div>
    </div>
  <% } %>

  <% if (view === 'login') { %>
    <!-- LOGIN VIEW -->
    <h5 class="fw-bold mb-1">Welcome Back</h5>
    <p class="text-muted small mb-4">Manage your paint shop stock with clarity.</p>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label small fw-semibold text-secondary">Email Address</label>
        <div class="input-group">
          <span class="input-group-text bg-light text-muted border-end-0"><i data-lucide="mail" style="width: 18px;"></i></span>
          <input type="email" name="email" class="form-control border-start-0" placeholder="admin@gmail.com" required autofocus>
        </div>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label class="form-label small fw-semibold text-secondary mb-0">Password</label>
          <a href="/forgot-password" class="text-sky small text-decoration-none fw-medium">Forgot Password?</a>
        </div>
        <div class="input-group">
          <span class="input-group-text bg-light text-muted border-end-0"><i data-lucide="lock" style="width: 18px;"></i></span>
          <input type="password" name="password" class="form-control border-start-0" placeholder="••••••••" required>
        </div>
      </div>

      <button type="submit" class="btn btn-sky w-full w-100 mt-2">
        Sign In to Portal
      </button>
    </form>

    <div class="mt-4 pt-3 border-top text-center text-muted extra-small">
      Shop Admin / Staff lost password? Contact your shop administrator.
    </div>

  <% } else if (view === 'forgot') { %>
    <!-- FORGOT PASSWORD VIEW (SUPER ADMIN) -->
    <h5 class="fw-bold mb-1">Forgot Password?</h5>
    <p class="text-muted small mb-3">Super Admin password recovery service.</p>

    <form action="/forgot-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label small fw-semibold text-secondary">Super Admin Email</label>
        <div class="input-group">
          <span class="input-group-text bg-light text-muted border-end-0"><i data-lucide="mail" style="width: 18px;"></i></span>
          <input type="email" name="email" class="form-control border-start-0" placeholder="admin@gmail.com" required autofocus>
        </div>
      </div>

      <button type="submit" class="btn btn-sky w-100 mb-3">
        Send Reset Link
      </button>

      <div class="text-center">
        <a href="/login" class="text-sky small text-decoration-none fw-semibold">
          &larr; Back to Login
        </a>
      </div>
    </form>

  <% } else if (view === 'reset') { %>
    <!-- RESET PASSWORD VIEW -->
    <h5 class="fw-bold mb-1">Create New Password</h5>
    <p class="text-muted small mb-3">Set a secure new password for your Super Admin account.</p>

    <div class="rule-box mb-3">
      <div class="fw-semibold mb-1">Password Requirements:</div>
      <ul class="mb-0 ps-3 small">
        <li>At least 8 characters</li>
        <li>At least 1 uppercase letter (A-Z)</li>
        <li>At least 1 lowercase letter (a-z)</li>
        <li>At least 1 number (0-9)</li>
      </ul>
    </div>

    <form action="/reset-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="mb-3">
        <label class="form-label small fw-semibold text-secondary">New Password</label>
        <input type="password" name="new_password" class="form-control" placeholder="••••••••" required autofocus>
      </div>

      <div class="mb-3">
        <label class="form-label small fw-semibold text-secondary">Confirm New Password</label>
        <input type="password" name="confirm_password" class="form-control" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-sky w-100 mb-3">
        Reset Password
      </button>

      <div class="text-center">
        <a href="/login" class="text-sky small text-decoration-none fw-semibold">
          &larr; Cancel and return to Login
        </a>
      </div>
    </form>
  <% } %>
</div>

<script>
  lucide.createIcons();
</script>
</body>
</html>
